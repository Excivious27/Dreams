# Reference unit for the live relay (installed at setup as /etc/systemd/system/dreams-relay.service).
[Unit]
Description=Dreams multiplayer relay (Node, behind Caddy)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/dreams/server
ExecStart=/usr/bin/node server.js
Environment=PORT=8787
Restart=always
RestartSec=2
NoNewPrivileges=true
# C17 hardening (c17_17-18): no root, a read-only system, a memory ceiling on the 512 MB droplet.
# The live box runs its setup copy; a rebuilt box installs this one (server.js only reads its
# checkout and binds 8787, so it needs no privileges).
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=384M

[Install]
WantedBy=multi-user.target
