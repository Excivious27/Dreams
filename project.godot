; Engine configuration file.
; Dreams: phone-first, portrait, pixel art.

config_version=5

[application]

config/name="Dreams"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.07, 0.11, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=270
window/size/viewport_height=480
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[autoload]

NetSvc="*res://scripts/net.gd"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.07, 0.11, 1)

[importer_defaults]

texture={
"compress/lossy_quality": 0.9,
"compress/mode": 1
}
